# Required everywhere
NVIDIA_API_KEY=your-nvidia-api-key

# Only needed when deploying (e.g. to Vercel). Leave unset for local development —
# the app automatically falls back to a local file (./data.db) when these are absent.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
